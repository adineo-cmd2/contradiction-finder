---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/corpus", "label": "Corpus"}, {"href": "/contradictions", "label": "Contradictions"}, {"href": "/network", "label": "Network"}, {"href": "/document", "label": "Document"}, {"href": "/settings", "label": "Settings"}];
---
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a href={base || '/'} class="brand" style="margin-bottom: 0.9rem">
        <span class="brand-mark" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 5h6l2 2h8v12H4z" />
            <path d="M8 12h8M8 15h5" />
          </svg>
        </span>
        <span>ContraLens</span>
      </a>
      <p>
        ContraLens — NLI detection is imperfect; every flag shows a confidence score for your review. Corpora are private to your account.
      </p>
      <p class="mono" style="margin-top: 1rem; font-size: 0.56rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft)">
        Case file CL-114 · evidence over assertion
      </p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Project</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/contradiction-finder" target="_blank" rel="noreferrer">Source on GitHub ↗</a></li>
        <li><a href="https://adineo-cmd2.github.io/contradiction-finder/" target="_blank" rel="noreferrer">Live site ↗</a></li>
        <li><span>Local backend · <span class="mono">localhost:8003</span></span></li>
        <li><span>FastAPI + Astro + React</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} ContraLens · Aditya Yadav</span>
      <span>Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
