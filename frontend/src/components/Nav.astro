---
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/corpus", "label": "Corpus"}, {"href": "/contradictions", "label": "Contradictions"}, {"href": "/network", "label": "Network"}, {"href": "/document", "label": "Document"}, {"href": "/settings", "label": "Settings"}];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5h6l2 2h8v12H4z" />
          <path d="M8 12h8M8 15h5" />
        </svg>
      </span>
      <span>ContraLens</span>
    </a>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href === '/' ? base || '/' : `${base}${l.href}`}
              data-navlink={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href={`${base}/corpus`} class="nav-link nav-cta">Open a case</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const close = () => {
      menu.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
