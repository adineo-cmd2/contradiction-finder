---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Find where your sources disagree.">
<h1 class="serif-h text-4xl">Find where your sources disagree.</h1>
<p class="mt-4 max-w-2xl">Upload a set of papers. ContraLens surfaces the places where your literature contradicts itself — across documents and within them — each with a confidence score for your review.</p>
<div class="mt-6 grid gap-3 md:grid-cols-3">
<div class="border border-slate-200 p-4"><p class="font-bold">1. Build a corpus</p><p class="text-sm opacity-70">Name it, upload PDF/DOCX/TXT.</p></div>
<div class="border border-slate-200 p-4"><p class="font-bold">2. Run analysis</p><p class="text-sm opacity-70">Similar pairs checked by NLI.</p></div>
<div class="border border-slate-200 p-4"><p class="font-bold">3. Review conflicts</p><p class="text-sm opacity-70">Table, network, inline flags.</p></div>
</div>
<a href="/corpus" class="mt-6 inline-block underline">Create a corpus</a>
</BaseLayout>
