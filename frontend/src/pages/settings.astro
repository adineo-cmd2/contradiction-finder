---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Settings">
  <header class="file-head">
    <div>
      <p class="eyebrow">File 05 / records</p>
      <h1 class="page-title">Settings</h1>
      <p class="page-intro">The case register. Each corpus held by the local backend is listed here; deleting one removes its documents and contradictions.</p>
    </div>
    <p class="file-meta">Local backend<br />localhost:8003</p>
  </header>
  <section class="form-sheet" aria-labelledby="register-title">
    <div class="form-sheet-head">
      <div>
        <p class="eyebrow">Register</p>
        <h2 id="register-title">Filed cases</h2>
      </div>
      <span class="mono">Destructive / confirm</span>
    </div>
    <div id="list" class="space-y-2"></div>
  </section>
  <script>
    const BASE = "http://localhost:8003";
    async function load() {
      const r = await fetch(`${BASE}/api/corpus`);
      const items = await r.json();
      const el = document.getElementById("list")!;
      el.innerHTML = "";
      for (const c of items) {
        const row = document.createElement("div");
        row.className = "case-row";
        const label = document.createElement("span");
        label.textContent = `${c.name} (${c.docs} docs)`;
        const b = document.createElement("button");
        b.className = "danger-link";
        b.textContent = "Delete";
        b.onclick = async () => {
          if (!confirm(`Delete corpus ${c.name}?`)) return;
          await fetch(`${BASE}/api/corpus/${c.id}`, { method: "DELETE" });
          load();
        };
        row.appendChild(label);
        row.appendChild(b);
        el.appendChild(row);
      }
    }
    load();
  </script>
</BaseLayout>
